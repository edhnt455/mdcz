{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["apps/server/src/**/*.ts", "apps/server/tsconfig*.json", "vitest.config.ts"],
  "exclude": ["packages/**/*.test.ts"],
  "references": [
    {
      "path": "./packages/shared"
    },
    {
      "path": "./packages/media-store"
    },
    {
      "path": "./packages/persistence"
    },
    {
      "path": "./packages/runtime"
    }
  ]
}
